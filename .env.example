# Firebase web app config — copy this file to `.env` and fill in the values
# from the Firebase console (Project settings > Your apps > Web app).
# These values are public client identifiers, NOT secrets, but keep them in
# `.env` (git-ignored) so the repo stays clean and deployable from any project.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# App Check (optional). If you have a reCAPTCHA v3 site key, set it here and
# App Check will use it. Otherwise the app uses the App Check debug provider
# when VITE_APPCHECK_DEBUG=true (accepted for hackathon submissions — register
# the debug token printed in the browser console under
# Firebase console > App Check > Manage debug tokens).
VITE_RECAPTCHA_V3_SITE_KEY=
VITE_APPCHECK_DEBUG=true
# If you created a debug token in the console (App Check > Manage debug
# tokens), put its value here so the app uses that exact token. Otherwise the
# SDK generates one and prints it to the browser console for registration.
VITE_APPCHECK_DEBUG_TOKEN=
